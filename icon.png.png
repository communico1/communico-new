\n        .then(reg \u003d\u003e console.log(&quot;,0],[&quot;&#39;App pronta!&#39;&quot;,4],[&quot;, reg))\n        .catch(err \u003d\u003e console.log(&quot;,0],[&quot;&#39;Errore configurazione app:&#39;&quot;,4],[&quot;, err));\n    });\n  }\n\u003c/&quot;,0],[&quot;script&quot;,3],[&quot;\u003e\n&quot;,0]]]]--></div><div class="yhAwj" data-sfc-cp="" jsaction="rcuQ6b:&amp;H5B7Tb_1p|npT2md" jscontroller="UTzWVc#U8DOt" data-sfc-root="c" jsuid="H5B7Tb_1p" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div class="ZLzG0d ncoeY E8xBUb" role="heading" aria-level="4" data-animation-nesting="" data-sfc-cp="" jsaction="" data-wiz-attrbind="aria-level=H5B7Tb_1q/fLk2Md" jscontroller="zg1ZQe#TswZNc" data-sfc-root="c" jsuid="H5B7Tb_1q" data-hveid="CAAIDBAA" data-complete="true" data-processed="true" data-sae="" style="">2. Crea il file <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="H5B7Tb_1r" data-complete="true" data-sae="" style="">service-worker.js<!--TgQPHd|||[]--></code><!--TgQPHd|||[[2,[null,null,1,null,null,null,null,null,null,null,null,null,[351768,null,0]],[],null,1]]--></div><div class="n6owBd awi2gc" data-sfc-cp="" jsaction="" jscontroller="TDBkbc#Ml18Xb" data-sfc-root="c" jsuid="H5B7Tb_1s" data-hveid="CAAIDRAA" data-complete="true" data-processed="true">Crea un nuovo file nella cartella principale del tuo codice (insieme a <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="H5B7Tb_1t" data-complete="true" data-sae="" style="">index.html<!--TgQPHd|||[]--></code> e <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="H5B7Tb_1u" data-complete="true" data-sae="" style="">manifest.json<!--TgQPHd|||[]--></code>), chiamalo esattamente <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="c" jsuid="H5B7Tb_1v" data-complete="true" data-processed="true"><
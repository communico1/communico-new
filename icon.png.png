</span><span class="uiJ0Tc">const</span><span class="undefined"> </span><span class="yqj1Pc">assets</span><span class="undefined"> = [
  </span><span class="dk3nFb">'/communico-new/'</span><span class="undefined">,
  </span><span class="dk3nFb">'/communico-new/index.html'</span><span class="undefined">,
  </span><span class="dk3nFb">'/communico-new/manifest.json'</span><span class="undefined">
];

</span><span class="ojrtQ">// Installazione dell'app in background</span><span class="undefined">
self.addEventListener(</span><span class="dk3nFb">'install'</span><span class="undefined">, e =&gt; {
  e.waitUntil(
    caches.open(CACHE_NAME).then(cache =&gt; {
      </span><span class="uiJ0Tc">return</span><span class="undefined"> cache.addAll(assets);
    })
  );
});

</span><span class="ojrtQ">// Gestione dei file per far funzionare l'app offline o con connessione lenta</span><span class="undefined">
self.addEventListener(</span><span class="dk3nFb">'fetch'</span><span class="undefined">, e =&gt; {
  e.respondWith(
    caches.match(e.request).then(response =&gt; {
      </span><span class="uiJ0Tc">return</span><span class="undefined"> response || fetch(e.request);
    })
  );
});
</span></code></pre></div></div><div class="iMHp6c" data-animation-atomic="true" data-sae="" style=""><div class="ZIumpf">Usa il codice con cautela.</div><span jsuid="ncGTjd_1b" jsaction="action:&amp;ncGTjd_1a|ZUljYd" data-ved="2ahUKEwjNreTBiPOXAxW_gv0HHclPNl8QopQPegYIAAgJEAE"><div jsuid="ncGTjd_1d" data-sfc-cp="" jsaction="" jscontroller="cXTEid#e0nEwf" data-sfc-root="c" data-ved="2ahUKEwjNreTBiPOXAxW_gv0HHclPNl8Qh9gSegYIAAgJEAI" data-complete="true" data-sfc-inited="2"><button jsuid="ncGTjd_1e" class="FTsWP RmjGdc IsqrXb" aria-label="Copia il testo del codice negli appunti." data-tooltip-x-position="undefined" data-tooltip-y-position="undefined" data-tooltip-classes="undefined" data-is-tooltip-wrapper="undefined" data-tooltip-id="undefined" data-sfc-cp="" jsaction="pointerdown:&amp;ncGTjd_1e|ZUljYd;pointerup:&amp;ncGTjd_1e|aXD3Gb;pointerenter:&amp;ncGTjd_1e|Mrjwi;pointerleave:&amp;ncGTjd_1e|CXhG2e;pointercancel:&amp;ncGTjd_1e|wndyDd;contextmenu:&amp;ncGTjd_1e|yrMC6;click:&amp;ncGTjd_1e|w9rIQb;focus:&amp;ncGTjd_1e|SAMwlb;blur:&amp;ncGTjd_1e|hQOfOb;" jscontroller="ETNkje#SiNNTb" data-sfc-root="c" data-complete="true" data-sfc-inited="2"><span class="XjoK4b kkxvEb" jsaction="" jscontroller="bJ5zY#LlrZ1b" data-sfc-root="c" jsuid="ncGTjd_1f" data-complete="true"><!--TgQPHd|||[]--></span><span jsuid="ncGTjd_1g" class="UTNHae" jsaction="QBlI0e:&amp;ncGTjd_1g|JwG8nd;BTifte:&amp;ncGTjd_1g|ie0cXb;nqgE9d:&amp;ncGTjd_1g|LZznfb;fHTtBd:&amp;ncGTjd_1g|i8hBpd;" jscontroller="MAxPne#DBBRWd" data-sfc-root="c" data-complete="true" data-sfc-inited="2"><!--TgQPHd|||[{&quot;u&quot;:0},false]--></span><span class="I36Cje" aria-hidden="true"><!--qkimaf ncGTjd_1a/HugV6--><svg aria-hidden="true" fill="currentColor" height="18px" viewBox="0 -960 960 960" width="18px"><path d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z"><
c4yxb_1h/lC1IR--><!--cqw1tb uc4yxb_1h/lC1IR--><!--TgQPHd|||[[&quot;d5871ab6-c03f-4abc-98a0-3754c68a3f05&quot;,null,null,0,&quot;&quot;,&quot;&quot;,0,null,null,null,null,0,null,0]]--></span><!--TgQPHd|||[]--></div><div class="yhAwj" data-sfc-cp="" jsaction="rcuQ6b:&amp;uc4yxb_1n|npT2md" jscontroller="UTzWVc#U8DOt" data-sfc-root="c" jsuid="uc4yxb_1n" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div class="ZLzG0d ncoeY E8xBUb" role="heading" aria-level="4" data-animation-nesting="" data-sfc-cp="" jsaction="" data-wiz-attrbind="aria-level=uc4yxb_1o/fLk2Md" jscontroller="zg1ZQe#TswZNc" data-sfc-root="c" jsuid="uc4yxb_1o" data-hveid="CAAIDRAA" data-complete="true" data-processed="true" data-sae="" style="">1. Il file <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="uc4yxb_1p" data-complete="true" data-sae="" style="">manifest.json<!--TgQPHd|||[]--></code><!--TgQPHd|||[[2,[null,null,1,null,null,null,null,null,null,null,null,null,[351768,null,0]],[],null,1]]--></div><div class="n6owBd awi2gc" data-sfc-cp="" jsaction="" jscontroller="TDBkbc#Ml18Xb" data-sfc-root="c" jsuid="uc4yxb_1q" data-hveid="CAAIDhAA" data-complete="true" data-processed="true">Crea un file chiamato <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="uc4yxb_1r" data-complete="true" data-sae="" style="">manifest.json<!--TgQPHd|||[]--></code> nella stessa cartella dell' <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="uc4yxb_1s" data-complete="true" data-sae="" style="">index.html<!--TgQPHd|||[]--></code>. Questo file dice al telefono che il sito è un'applicazione.<span jsuid="uc4yxb_1t" class="DHPVt Wg1cdb notranslate" data-suuid="nCd0md|70de4e38-a673-46c5-8638-60680cff103f-|" jsaction="rcuQ6b:&amp;uc4yxb_1t|npT2md" jscontroller="XqmSxe#JjQTXe" data-sfc-root="c" data-wiz-uids="uc4yxb_1v,uc4yxb_1u,uc4yxb_1w,uc4yxb_1x" data-complete="true" data-processed="true" data-sfc-inited="2"><span class="NMq1me" data-animation-atomic="true" jsaction="click:&amp;uc4yxb_1t|ZUljYd" data-sae="" style=""><span aria-hidden="true">&nbsp;</span><span class=""><span class=""><!--qkimaf uc4yxb_1t/WyzG9e--><!--cqw1tb uc4yxb_1t/WyzG9e--><button jsuid="uc4yxb_1u" tabindex="0" data-amic="true" data-icl-uuid="70de4e38-a673-46c5-8638-60680cff103f" aria-label="Risultati correlati" class="vDOt8c" jsaction="click:&amp;uc4yxb_1t|yrMC6;mouseenter:&amp;uc4yxb_1t|w9rIQb;mouseleave:&amp;uc4yxb_1t|SAMwlb" data-ved="2ahUKEwijps2biPOXAxVZgP0HHblUL_oQxcQVegYIAAgOEAE" data-hveid="CAAIDhAB"><span class="pxxQye T6UJT"><div class="a14YJe"><svg class="EQxvpc MZhYme" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" aria-hidden="true" jsaction="" jscontroller="vODoFe#cKfyCe" data-sfc-root="c" jsuid="uc4yxb_1y" data-complete="true"><path d="M440-280H280q-83,0-141.5-58.5T80-480t58.5-141.5T280-680H440v80H280q-50,0-85,35t-35,85t35,85t85,35H440v80ZM320-440v-80H640v80H320ZM520-280v-80H680q50,0 85-35t35-85t-35-85t-85-35H520v-80H680q83,0 141.5,58.5T880-480T821.5-338.5T680-280H520Z"></path><!--TgQPHd|||[]--></svg></div></span><div jsuid="uc4yxb_1v" style="display: none;" data-ved="2ahUKEwijps2biPOXAxVZgP0HHblUL_oQlZkRegYIAAgOEAI"></div></button></span></span></span><!--qkimaf uc4yxb_1t/lC1IR--><!--cqw1tb uc4yxb_1t/lC1IR--><!--TgQPHd|||[[&quot;70de4e38-a673-46c5-8638-60680cff103f&quot;,null,null,0,&quot;&quot;,&quot;&quot;,0,null,null,null,null,0,null,0]]--></span><!--TgQPHd|||[]--></div><div class="yhAwj" data-sfc-cp="" jsaction="rcuQ6b:&amp;uc4yxb_1z|npT2md" jscontroller="UTzWVc#U8DOt" data-sfc-root="c" jsuid="uc4yxb_1z" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div jsuid="uc4yxb_20" class="BpxUDf aiModeUiCodeBlock__Container" data-sfc-cp="" jsaction="" jscontroller="Liu6s#lcO7sb" data-sfc-root="c" data-wiz-uids="uc4yxb_22,uc4yxb_21" data-hveid="CAAIDxAA" data-complete="true" data-processed="true"><div data-processed="true"><div class="rq1a2" data-animation-atomic="true" data-sae="" style=""><div class="a2TNg"><div class="GlO4G">json</div></div><div class="PGvq2d" dir="ltr"><pre><code jsuid="uc4yxb_22"><span class="undefined">{
  </span><span class="dk3nFb">"short_name"</span><span class="undefined">: </span><span class="dk3nFb">"Communico"</span><span class="undefined">,
  </span><span class="dk3nFb">"name"</span><span class="undefined">: </span><span class="dk3nFb">"Communico App"</span><span class="undefined">,
  </span><span class="dk3nFb">"icons"</span><span class="undefined">: [

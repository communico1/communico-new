  </span><span class="dk3nFb">"display"</span><span class="undefined">: </span><span class="dk3nFb">"standalone"</span><span class="undefined">,
  </span><span class="dk3nFb">"orientation"</span><span class="undefined">: </span><span class="dk3nFb">"portrait"</span><span class="undefined">

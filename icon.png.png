se || fetch(event.request);\n    })\n  );\n});\n&quot;,0]]]]--></div><div class="yhAwj" data-sfc-cp="" jsaction="rcuQ6b:&amp;H5B7Tb_2b|npT2md" jscontroller="UTzWVc#U8DOt" data-sfc-root="c" jsuid="H5B7Tb_2b" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div class="ZLzG0d ncoeY E8xBUb" role="heading" aria-level="4" data-animation-nesting="" data-sfc-cp="" jsaction="" data-wiz-attrbind="aria-level=H5B7Tb_2c/fLk2Md" jscontroller="zg1ZQe#TswZNc" data-sfc-root="c" jsuid="H5B7Tb_2c" data-hveid="CAAIDxAA" data-complete="true" data-processed="true" data-sae="" style="">3. Le Icone (Molto importante)<!--TgQPHd|||[[2,[null,null,1,null,null,null,null,null,null,null,null,null,[351768,null,0]],[],null,1]]--></div><div class="n6owBd awi2gc" data-sfc-cp="" jsaction="" jscontroller="TDBkbc#Ml18Xb" data-sfc-root="c" jsuid="H5B7Tb_2d" data-hveid="CAAIEBAA" data-complete="true" data-processed="true">Controlla dentro il tuo <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="H5B7Tb_2e" data-complete="true" data-sae="" style="">manifest.json<!--TgQPHd|||[]--></code> i nomi delle icone che hai impostato (di solito si chiamano <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="H5B7Tb_2f" data-complete="true" data-sae="" style="">icon-192.png<!--TgQPHd|||[]--></code> e <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="c" jsuid="H5B7Tb_2g" data-complete="true" data-sae="" style="">icon-512.png<!--TgQPHd|||[]--></code>). Assicurati di <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="c" jsuid="H5B7Tb_2h" data-complete="true" data-processed="true">caricare queste due immagini quadrate<!--TgQPHd|||[]--></strong> sul tuo GitHub con gli stessi identici nomi, altrimenti lo smartphone non saprà che logo mostrare sullo schermo del telefono.<span jsuid="H5B7Tb_2i" class="DHPVt Wg1cdb notranslate" data-suuid="nCd0md|f5e79846-dfd6-4550-88f8-3ffdc8660148-|" jsaction="rcuQ6b:&amp;H5B7Tb_2i|npT2md" jscontroller="XqmSxe#JjQTXe" data-sfc-root="c" data-wiz-uids="H5B7Tb_2k,H5B7Tb_2j,H5B7Tb_2l,H5B7Tb_2m" data-complete="true" data-processed="true" data-sfc-inited="2"><span class="NMq1me" data-animation-atomic="true" jsaction="click:&amp;H5B7Tb_2i|ZUljYd" data-sae="" style=""><span aria-hidden="true">&nbsp;</span><span class=""><span class=""><!--qkimaf H5B7Tb_2i/WyzG9e--><!--cqw1tb H5B7Tb_2i/WyzG9e--><button jsuid="H5B7Tb_2j" tabindex="0" data-amic="true" data-icl-uuid="f5e79846-dfd6-4550-88f8-3ffdc8660148" aria-label="Risultati correlati" class="vDOt8c" jsaction="click:&amp;H5B7Tb_2i|yrMC6;mouseenter:&amp;H5B7Tb_2i|w9rIQb;mouseleave:&amp;H5B7Tb_2i|SAMwlb" data-ved="2ahUKEwis9IWniPOXAxUFgv0HHYJ7EF0QxcQVegYIAAgQEAE" data-hveid="CAAIEBAB"><span class="pxxQye T6UJT"><div class="a14YJe"><svg class="EQxvpc MZhYme" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" aria-hidden="true" jsaction="" jscontroller="vODoFe#cKfyCe" data-sfc-root="c" jsuid="H5B7Tb_2n" data-complete="true"><path d="M440-280H280q-83,0-141.5-58.5T80-480t58.5-141.5T280-680H440v80H280q-50,0-85,35t-35,85t35,85t85,35H440v80ZM320-440v-80H640v80H320ZM520-280v-80H680q50,0 85-35t35-85t-35-85t-85-35H520v-80H680q83,0 141.5,58.5T880-480T821.5-338.5T680-280H520Z"></path><!--TgQPHd|||[]--></svg></div></span><div jsuid="H5B7Tb_2k" style="display: none;" data-ved="2ahUKEwis9IWniPOXAxUFgv0HHYJ7EF0QlZkRegYIAAgQEAI"></div></button></span></span></span><!--qkimaf H5B7Tb_2i/lC1IR--><!--cqw1tb H5B7Tb_2i/lC1IR--><!--TgQPHd|||[[&quot;f5e79846-dfd6-4550-88f8-3ffdc8660148&quot;,null,null,0,&quot;&quot;,&quot;&quot;,0,null,null,null,null,0,null,0]]--></span><!--TgQPHd|||[]--></div><div class="n6owBd awi2gc" data-sfc-cp="" jsaction="" jscontroller="TDBkbc#Ml18Xb" data-sfc-root="c" jsuid="H5B7Tb_2o" data-hveid="CAAIERAA" data-complete="true" data-processed="true">Una volta salvate le modifiche su GitHub, aspetta un paio di minuti, svuota la cache del telefono e prova a ricaricare il sito: vedrai comparire l'opzione per installarlo!<span jsuid="H5B7Tb_2p" class="DHPVt Wg1cdb notranslate" data-suuid="nCd0md|de98daab-7998-4375-86fe-b251696f8acf-|" jsaction="rcuQ6b:&amp;H5B7Tb_2p|npT2md" jscontroller="XqmSxe#JjQTXe" data-sfc-root="c" data-wiz-uids="H5B7Tb_2r,H5B7Tb_2q,H5B7Tb_2s,H5B7Tb_2t" data-complete="true" data-processed="true" data-sfc-inited="2"><span class="NMq1me" data-animation-atomic="true" jsaction="click:&amp;H5B7Tb_2p|ZUljYd" data-sae="" style=""><span aria-hidden="true">&nbsp;</span><span class=""><span class=""><!--qkimaf H5B7Tb_2p/WyzG9e--><!--cqw1tb H5B7Tb_2p/WyzG9e--><button jsuid="H5B7Tb_2q" tabindex="0" data-amic="true" data-icl-uuid="de98daab-7998-4375-86fe-b251696f8acf" aria-label="Risultati correlati" class="vDOt8c" jsaction="click:&amp;H5B7Tb_2p|yrMC6;mouseenter:&amp;H5B7Tb_2p|w9rIQb;mouseleave:&amp;H5B7Tb_2p|SAMwlb" data-ved="2ahUKEwis9IWniPOXAxUFgv0HHYJ7EF0QxcQVegYIAAgREAE" data-hveid="CAAIERAB"><span class="pxxQye T6UJT"><div class="a14YJe"><svg class="EQxvpc MZhYme" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" aria-hidden="true" jsaction="" jscontroller="vODoFe#cKfyCe" data-sfc-root="c" jsuid="H5B7Tb_2u" data-complete="true"><path d="M440-280H280q-83,0-141.5-58.5T80-480t58.5-141.5T280-680H440v80H280q-50,0-85,35t-35,85t35,85t85,35H440v80ZM320-440v-80H640v80H320ZM520-280v-80H680q50,0 85-35t35-85t-35-85t-85-35H520v-80H680q83,0 141.5,58.5T880-480T821.5-338.5T680-280H520Z"></path><!--TgQPHd|||[]--></svg></div></span><div jsuid="H5B7Tb_2r" style="display: none;" data-ved="2ahUKEwis9IWniPOXAxUFgv0HHYJ7EF0QlZkRegYIAAgREAI"></div></button></span></span></span><!--qkimaf H5B7Tb_2p/lC1IR--><!--cqw1tb H5B7Tb_2p/lC1IR--><!--TgQPHd|||[[&quot;de98daab-7998-4375-86fe-b251696f8acf&quot;,null,null,0,&quot;&quot;,&quot;&quot;,0,null,null,null,null,0,null,0]]--></span><!--TgQPHd|||[]--></div><div class="yhAwj" data-